# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated allowed origins, or * for any (dev only)
CORS_ORIGIN=*

# ── Database (PostgreSQL) ──────────────────────────────
# Local Postgres (e.g. the Docker one in README):
DATABASE_URL=postgresql://acespect:acespect@localhost:5432/acespect?schema=public
# Supabase (Project Settings → Database → Connection string → "URI").
# Use the pooled "Transaction" connection on port 6543 for serverless,
# or the direct 5432 string for long-lived servers + migrations:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Prisma's connection pool (added to DATABASE_URL for Prisma only; a connection_limit / pool_timeout already in the URL wins).
# The app opens at most DATABASE_CONNECTION_LIMIT + 3 (pg-boss) connections per running instance.
# DATABASE_CONNECTION_LIMIT=10
# DATABASE_POOL_TIMEOUT=20
# Report photographs fetched at once across all PDF/Word builds on this server.
# REPORT_PHOTO_CONCURRENCY=6

# ── JWT ────────────────────────────────────────────────
# Generate strong secrets:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ── Google sign-in (optional) ──────────────────────────
# Comma-separated Google OAuth client IDs allowed as the `aud` of incoming
# ID tokens (the web + iOS + Android client IDs from Google Cloud Console).
# Leave empty to disable Google sign-in (the /auth/google route returns 501).
GOOGLE_CLIENT_IDS=

# ── Photo / file storage ───────────────────────────────
# STORAGE_PROVIDER=azure|egnyte. Default: azure in production, egnyte elsewhere.
# Azure Blob Storage in Azure: the backend signs in as its managed identity (no key or SAS).
#   STORAGE_PROVIDER=azure
#   AZURE_STORAGE_ACCOUNT_NAME=acespectstorage
#   AZURE_STORAGE_CONTAINER=inspection-photos
# Local development with the Azurite emulator (npx azurite --silent --location /tmp/azurite):
#   STORAGE_PROVIDER=azure
#   AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
STORAGE_PROVIDER=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=inspection-photos
AZURE_STORAGE_CONNECTION_STRING=

# ── Egnyte photo storage (STORAGE_PROVIDER=egnyte; optional locally) ────────────
# Leave empty to run with photo storage disabled (uploads return 503; the
# rest of the app works fine). EGNYTE_DOMAIN is the subdomain part of your
# org's Egnyte URL, e.g. "houspect" for houspect.egnyte.com.
EGNYTE_DOMAIN=
EGNYTE_API_TOKEN=
EGNYTE_ROOT_FOLDER=/Shared/Inspection Photos
# This backend's own public URL -- used to build the /api/v1/media proxy
# links returned for uploaded photos (Egnyte's own share links open a web
# viewer, not a raw image, so we never hand those out directly).
PUBLIC_BASE_URL=http://localhost:4000

# ── Accounts and sign-in ──
# Can anyone create an account from the phone app? "off" (the default): accounts come from an administrator's invitation (Admin -> Users).
# Set "on" only for local tests.
SELF_SIGNUP=off
# Houspect roles that must use two-step sign-in, comma separated (ADMIN,REVIEWER). Empty = not enforced. Each person then sets up an
# authenticator at their next sign-in, so tell them first.
MFA_REQUIRED_PLATFORM_ROLES=
# Invitation and password-reset emails need SMTP_URL (e.g. smtps://user:pass@smtp.example.com) and MAIL_FROM. Without them the
# administrator is shown the link to pass on.

# Address of the deployed web app. PDF and Word reports are made by opening its /report/:id page, so this must be set in production
# (Azure: https://ambitious-sand-059c7ba00.3.azurestaticapps.net). Unset, it defaults to http://localhost:5173 and every report download fails.
WEB_APP_URL=http://localhost:5173
