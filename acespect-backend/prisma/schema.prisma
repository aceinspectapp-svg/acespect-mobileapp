// ACE SPECT — database schema (PostgreSQL / Supabase)
// Auth slice only for now. Inspection / media / sync tables land here next.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single role for v1 (INSPECTOR). The enum is defined wide so RBAC can
/// expand to ADMIN / REVIEWER / CLIENT without a data migration.
/// FIELD_USER: a QC-only field worker (Trade/Builder) created by an ADMIN
/// from the dashboard -- distinct from INSPECTOR (a Houspect account), but
/// either role can be a QC defect/task assignee.
enum Role {
  INSPECTOR
  ADMIN
  REVIEWER
  CLIENT
  FIELD_USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Nullable: Google-only accounts have no local password.
  passwordHash String?
  name         String?
  phone        String?
  // Set when the account is linked to a Google identity (the Google "sub").
  googleId     String?  @unique
  avatarUrl    String?
  avatar       String? // short initials shown in the web UI, e.g. "JT"
  region       String?
  // Inspector's building-inspector license/registration number (e.g. DBU
  // license). Shown alongside their name in the reviewer pane and used as
  // the report cover's "Inspector DBU License" fallback when the inspection
  // itself doesn't override it. Meaningful for INSPECTOR accounts; left
  // null for other roles.
  licenseNumber String?
  role         Role     @default(INSPECTOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  inspections         Inspection[]         @relation("InspectorInspections")
  assignedReviews     Inspection[]         @relation("ReviewerInspections")
  reviewDecisions     ReviewDecision[]     @relation("ReviewerDecisions")
  createdTemplates    InspectionTemplate[]
  templateAcceptances TemplateAcceptance[]
  createdQcDefects    QcDefect[]           @relation("QcDefectCreatedBy")
  assignedQcDefects   QcDefect[]           @relation("QcDefectAssignedTo")
  assignedQcTasks     QcTask[]             @relation("QcTaskAssignedTo")
  qcTaskUpdates       QcTaskUpdate[]
  submissionLogEntries SubmissionLogEntry[]

  @@map("users")
}

// ───────────────────────── Inspection lifecycle (web review workflow) ─────────────
enum InspectionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum SectionStatus {
  COMPLETE
  PARTIAL
  PENDING
}

enum SectionReviewStatus {
  PENDING
  APPROVED
  REVISION_REQUESTED
}

/// Opaque refresh tokens, stored hashed (SHA-256). Enables rotation and
/// server-side revocation — a stolen refresh token can be invalidated,
/// which a stateless JWT refresh cannot.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ───────────────────────── Inspection + AI review pipeline ─────────────────────────
// A submitted inspection is reviewed asynchronously by a multi-agent worker
// (form ∥ photo → risk → summary). The queue/worker lives in the app; the agents
// run in a separate Python LangGraph service the worker calls over HTTP.

enum ReviewStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum AgentKind {
  PHOTO
  FORM
  RISK
  SUMMARY
}

/// Lifecycle of the human reviewer's verdict on the AI summary. AI output is
/// advisory — a reviewer always approves / edits / rejects before it's final.
enum SummaryStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
}

enum DecisionKind {
  APPROVED
  REJECTED
  EDITED
}

/// A building inspection. Inspectors fill it (mobile) section by section;
/// reviewers act on it (web) per-section. `payload`/`photos` are legacy slots
/// kept for the AI pipeline; the structured form lives in `sections`.
model Inspection {
  id              String           @id @default(uuid())
  jobNo           String?
  inspector       User             @relation("InspectorInspections", fields: [inspectorId], references: [id])
  inspectorId     String
  reviewer        User?            @relation("ReviewerInspections", fields: [reviewerId], references: [id])
  reviewerId      String?
  address         String?
  suburb          String?
  client          String?
  inspectionType  String           @default("Dilapidation")
  propertyType    String           @default("Residential House")
  status          InspectionStatus @default(DRAFT)
  overallProgress Int              @default(0)
  notes           String           @default("")
  date            DateTime         @default(now())
  version         Int              @default(1)
  payload         Json?
  photos          Json?
  submittedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  /// Set only on a Post-Dilapidation job: the earlier, already-submitted
  /// inspection this one is being assessed against. Its presence (not a
  /// separate inspectionType) is what makes an inspection "post-dilap" --
  /// admin sets it once, when creating the job (see POST
  /// /review/inspections/:id/create-post-dilapidation), and the mobile app
  /// uses it both to know to render the comparison UI and to fetch the
  /// baseline's own section data as read-only reference.
  baselineInspection   Inspection?  @relation("PostDilapidationBaseline", fields: [baselineInspectionId], references: [id])
  baselineInspectionId String?
  /// The reverse side -- every later inspection that used this one as its baseline.
  postDilapidationJobs Inspection[] @relation("PostDilapidationBaseline")

  sections      Section[]
  reviewJobs    ReviewJob[]
  reviewSummary ReviewSummary?

  @@index([inspectorId])
  @@index([reviewerId])
  @@index([baselineInspectionId])
  @@map("inspections")
}

/// One section of an inspection form (Job Info, Driveway, …). Holds the
/// inspector's field data + photos + damages, and the reviewer's verdict.
model Section {
  id            String              @id @default(uuid())
  inspection    Inspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId  String
  key           String // stable slug e.g. "driveway"
  name          String
  icon          String              @default("")
  order         Int                 @default(0)
  status        SectionStatus       @default(PENDING)
  reviewStatus  SectionReviewStatus @default(PENDING)
  reviewComment String              @default("")
  reportText    String              @default("")
  fields        Json                @default("{}")
  /// The inspector's raw, un-flattened answer tree for this section, exactly as
  /// the mobile form held it. `fields` above is the flattened report view, which
  /// collapses repeating-group instances into a joined label string and so
  /// cannot be turned back into an editable form -- this is what makes
  /// "edit a submitted inspection" possible without losing per-instance detail.
  answers       Json?
  photos        Json                @default("[]")
  /// URLs from `photos` a reviewer has chosen to leave out of the generated
  /// report -- everything defaults to included, so existing inspections are
  /// unaffected until a reviewer actually excludes something.
  excludedPhotoUrls Json            @default("[]")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  damages Damage[]

  @@index([inspectionId])
  @@map("sections")
}

/// A defect record within a section (crack, leaning post, …).
model Damage {
  id        String  @id @default(uuid())
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String
  type      String
  location  String  @default("")
  direction String  @default("")
  widthMm   Float   @default(0)
  lengthMm  Float   @default(0)
  notes     String  @default("")
  photos    Json    @default("[]")
  /// Same as Section.excludedPhotoUrls, scoped to this damage record's own photos.
  excludedPhotoUrls Json @default("[]")
  order     Int     @default(0)

  @@index([sectionId])
  @@map("damages")
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Admin-defined structure of a section's fields (labels, types, order),
/// versioned per (inspectionType, propertyType, sectionKey) lineage --
/// templates are fully independent per profile combo (e.g. Dilapidation +
/// Residential vs Dilapidation + Apartment each get their own Driveway
/// template). Publishing a new version archives the previously-published
/// one rather than mutating it, so an inspection already in progress keeps
/// rendering whichever version it started with -- the mobile app pins the
/// template it fetched at the start of the draft.
/// `fields` is unstructured JSON (a recursive TemplateField[] shape --
/// leaf fields plus repeating-group/damage-list fields that nest their own
/// itemFields), matching how Section.fields is already unstructured in
/// this schema.
model InspectionTemplate {
  id             String         @id @default(uuid())
  inspectionType String // "dilapidation" | "pre_purchase" | "construction_stage" | "investigations"
  propertyType   String // "residential_house" | "apartment" | "commercial_properties" | "public_assets"
  sectionKey     String // "job-info", "elevations", "internal_areas", ...
  name           String
  version        Int // increments per (inspectionType, propertyType, sectionKey) lineage
  status         TemplateStatus @default(DRAFT)
  fields         Json // TemplateField[]
  /// Optional presentation hint for the mobile renderer. Today the only mode
  /// is { mode: "section-nav", groups: [{ letter, icon, hint }] }, which makes
  /// a long template render as a tap-through list of its `sectionLetter`
  /// groups (one full-screen form each) rather than one endless scroll --
  /// needed for profiles like Apartment whose sections carry 8-13 sub-areas.
  layout         Json?
  createdBy      User           @relation(fields: [createdById], references: [id])
  createdById    String
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  acceptances TemplateAcceptance[]

  @@index([inspectionType, propertyType, sectionKey, status])
  @@map("inspection_templates")
}

/// Per-inspector, per-section-lineage record of which template VERSION the
/// inspector is currently on for NEW inspections. Publishing a new version
/// never touches this table -- an inspector keeps rendering/using whatever
/// they're pointed at here until they explicitly accept an update (see
/// templates.service.ts `acceptProfileUpdates`). The first time an inspector
/// ever fetches a lineage with no row here, one is auto-created pointing at
/// whatever's currently published (nothing to migrate away from).
model TemplateAcceptance {
  id                 String              @id @default(uuid())
  inspector          User                @relation(fields: [inspectorId], references: [id], onDelete: Cascade)
  inspectorId        String
  inspectionType     String
  propertyType       String
  sectionKey         String
  acceptedTemplate   InspectionTemplate  @relation(fields: [acceptedTemplateId], references: [id])
  acceptedTemplateId String
  /// First time `GET /templates/updates` surfaced this as pending -- an
  /// in-app "have they even seen it" signal for the admin adoption view,
  /// distinct from `acceptedAt`.
  notifiedAt         DateTime?
  acceptedAt         DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([inspectorId, inspectionType, propertyType, sectionKey])
  @@index([inspectorId])
  @@map("template_acceptances")
}

/// One review run for a given inspection version. The (inspectionId, version)
/// uniqueness + the BullMQ jobId of the same shape make re-submits idempotent.
model ReviewJob {
  id           String       @id @default(uuid())
  inspection   Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId String
  version      Int
  status       ReviewStatus @default(QUEUED)
  attempts     Int          @default(0)
  error        String?
  queuedAt     DateTime     @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  results AgentResult[]

  @@unique([inspectionId, version])
  @@index([status])
  @@map("review_jobs")
}

/// Structured output of a single agent node (typed JSON), plus run metadata
/// for cost/latency tracking.
model AgentResult {
  id          String    @id @default(uuid())
  reviewJob   ReviewJob @relation(fields: [reviewJobId], references: [id], onDelete: Cascade)
  reviewJobId String
  agent       AgentKind
  output      Json
  model       String?
  tokensUsed  Int?
  latencyMs   Int?
  createdAt   DateTime  @default(now())

  @@unique([reviewJobId, agent])
  @@index([reviewJobId])
  @@map("agent_results")
}

/// The reviewer-facing synthesis (one per inspection) the Summary agent produces.
model ReviewSummary {
  id           String        @id @default(uuid())
  inspection   Inspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId String        @unique
  riskScore    Int?
  flags        Json?
  summaryText  String?
  status       SummaryStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  decisions ReviewDecision[]

  @@map("review_summaries")
}

/// Audit trail of human decisions on a summary (who, what, when, why).
model ReviewDecision {
  id              String        @id @default(uuid())
  reviewSummary   ReviewSummary @relation(fields: [reviewSummaryId], references: [id], onDelete: Cascade)
  reviewSummaryId String
  reviewer        User          @relation("ReviewerDecisions", fields: [reviewerId], references: [id])
  reviewerId      String
  decision        DecisionKind
  notes           String?
  decidedAt       DateTime      @default(now())

  @@index([reviewSummaryId])
  @@map("review_decisions")
}

/// Photo storage is Egnyte-backed (lib/storage.ts) -- this table is just a
/// lightweight id -> Egnyte path index, so /api/v1/media/:id can stay a
/// clean opaque id (never leaking the underlying folder structure to
/// clients) while the actual file lives at a path organized by
/// inspection/section. `data` is a leftover from the brief interim period
/// this table held the bytes directly; kept nullable rather than dropped so
/// no migration is needed either way, and left unpopulated going forward.
model Photo {
  id          String   @id @default(uuid())
  storageKey  String?
  data        Bytes?
  contentType String
  createdAt   DateTime @default(now())

  @@map("photos")
}

// ───────────────────────── QC — admin-configured defect tracking ──────────────────
// Client -> Project -> Property hierarchy, plus admin-defined severity and
// defect-status lifecycles, and the defect/task/update records themselves.
// An ADMIN (web dashboard) owns configuration, defect creation, and
// assignment; a field user (INSPECTOR or FIELD_USER) only sees tasks
// assigned to them and can post updates / mark their own task complete.
// Ported from the mobile-only prototype in acespect-mobile's QcDataContext
// and constants/qcData.ts -- same business rules, now shared/persisted.

model QcClient {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects QcProject[]

  @@map("qc_clients")
}

model QcProject {
  id        String   @id @default(uuid())
  name      String
  client    QcClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties QcProperty[]

  @@index([clientId])
  @@map("qc_projects")
}

/// House / Apartment / Townhouse / Duplex, admin-editable (label/icon/order).
model QcPropertyType {
  id    String @id @default(uuid())
  key   String @unique
  label String
  icon  String @default("home-outline")
  order Int    @default(0)

  properties QcProperty[]

  @@map("qc_property_types")
}

model QcProperty {
  id             String         @id @default(uuid())
  name           String
  project        QcProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  propertyType   QcPropertyType @relation(fields: [propertyTypeId], references: [id])
  propertyTypeId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  defects QcDefect[]

  @@index([projectId])
  @@map("qc_properties")
}

/// Major / Moderate / Minor / Observation, admin-editable.
model QcSeverity {
  id    String @id @default(uuid())
  key   String @unique
  label String
  color String
  order Int    @default(0)

  defects QcDefect[]

  @@map("qc_severities")
}

/// The 11-stage defect lifecycle (Open -> ... -> Verified/Closed -> ...),
/// admin-editable. `meaning` is the human-readable explanation shown in the
/// status-change sheet.
model QcStatus {
  id      String @id @default(uuid())
  key     String @unique
  label   String
  color   String
  meaning String @default("")
  order   Int    @default(0)

  defects QcDefect[]

  @@map("qc_statuses")
}

/// A logged defect. Only an ADMIN creates/edits/reassigns/reclassifies one --
/// enforced at the API layer (requireRole('ADMIN')), not by this table shape.
model QcDefect {
  id              String     @id @default(uuid())
  property        QcProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId      String
  location        String
  locationDetails String?
  summary         String
  severity        QcSeverity @relation(fields: [severityId], references: [id])
  severityId      String
  status          QcStatus   @relation(fields: [statusId], references: [id])
  statusId        String
  assignedTo      User?      @relation("QcDefectAssignedTo", fields: [assignedToId], references: [id])
  assignedToId    String?
  dueDate         DateTime?
  createdBy       User       @relation("QcDefectCreatedBy", fields: [createdById], references: [id])
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tasks QcTask[]

  @@index([propertyId])
  @@index([assignedToId])
  @@index([statusId])
  @@map("qc_defects")
}

/// Simple 3-stage assignment-progress flag -- distinct from QcStatus's rich,
/// admin-configurable defect lifecycle above.
enum QcTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum QcTaskPriority {
  HIGH
  MEDIUM
  LOW
}

/// The assignment wrapper around a QcDefect -- created automatically
/// alongside the defect (see qc.service.ts createDefect) with the same
/// assignee. Exists separately from QcDefect so "my assigned work" (task)
/// stays conceptually distinct from "the formal defect record".
model QcTask {
  id           String         @id @default(uuid())
  defect       QcDefect       @relation(fields: [defectId], references: [id], onDelete: Cascade)
  defectId     String
  assignedTo   User           @relation("QcTaskAssignedTo", fields: [assignedToId], references: [id])
  assignedToId String
  priority     QcTaskPriority @default(LOW)
  status       QcTaskStatus   @default(PENDING)
  dueDate      DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  updates QcTaskUpdate[]

  @@index([defectId])
  @@index([assignedToId])
  @@map("qc_tasks")
}

/// One site-visit entry in a task's activity log. `photoUrls` holds
/// `/api/v1/media/:id` proxy links (same convention as Section/Damage.photos
/// elsewhere in this schema -- a JSON array of media URLs, not a relational
/// join to Photo) built from the same lib/storage.ts upload pipeline.
model QcTaskUpdate {
  id            String       @id @default(uuid())
  task          QcTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId        String
  author        User         @relation(fields: [authorId], references: [id])
  authorId      String
  comment       String       @default("")
  photoUrls     Json         @default("[]")
  statusAfter   QcTaskStatus
  statusChanged Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([taskId])
  @@map("qc_task_updates")
}

/// Trace of the mobile app's submit/update/finalize/photo-upload attempts
/// reaching (or failing to reach) the database -- surfaced in the admin
/// dashboard as a troubleshooting view ("did this inspector's job actually
/// arrive, and if not, why") without anyone needing direct server-log or
/// database access. `inspector`/`inspectionId` are both nullable: a
/// rejected submission (failed validation, bad auth) never created a real
/// Inspection row and may not even have resolved a valid user.
model SubmissionLogEntry {
  id           String   @id @default(uuid())
  /// "received" | "saved" | "updated" | "finalized" | "photo_uploaded" | "rejected"
  event        String
  inspector    User?    @relation(fields: [inspectorId], references: [id], onDelete: SetNull)
  inspectorId  String?
  inspectionId String?
  jobNo        String?
  statusCode   Int?
  message      String?
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([inspectorId])
  @@index([inspectionId])
  @@index([createdAt])
  @@map("submission_log_entries")
}
