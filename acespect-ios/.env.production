# Read by the Expo CLI when it bundles the JS for a Release build, including the
# "Bundle React Native code and images" phase inside Xcode (which does not see
# eas.json or your shell variables). EXPO_PUBLIC_* values are public by design.
# Base URL only: src/config/api.ts adds /api/v1 itself.
EXPO_PUBLIC_API_URL=https://acespect-api-prod-cqcmgpdrbrcebggn.australiaeast-01.azurewebsites.net
